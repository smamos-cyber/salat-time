<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Salati" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/card</item>
        <item name="colorPrimaryDark">@color/bg_top</item>
        <item name="colorAccent">@color/gold</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="alertDialogTheme">@style/Dialog.Salati</item>
    </style>

    <style name="Dialog.Salati" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/gold</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Salati.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:minWidth">180dp</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">28dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Activité invisible utilisée uniquement pour rallumer l'écran -->
    <style name="Theme.Salati.Wake" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">false</item>
    </style>
</resources>
